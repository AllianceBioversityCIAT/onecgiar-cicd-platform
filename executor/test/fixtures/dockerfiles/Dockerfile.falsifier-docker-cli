# @akili-spec changes/cicd-executor-poc requirements NFR-01; design §4.2
#
# T-01 falsifier fixture: an otherwise-faithful copy of ../../../Dockerfile
# with the Docker CLI installed in the final (shipped) stage. This MUST
# fail both the static scanner (test/support/dockerfile-boundary-scanner.ts
# — "forbidden-package:docker package") and the real image-inspection gate
# (scripts/inspect-image.mjs, which would find /usr/bin/docker on disk).
#
# The Leader runs, once a Docker daemon is reachable:
#   npm run inspect:image -- --dockerfile test/fixtures/dockerfiles/Dockerfile.falsifier-docker-cli
# and expects a non-zero exit with a BOUNDARY_FAIL report naming "docker".
#
# Do not "fix" this file — it exists to demonstrate the gate can go red.

FROM node:22-slim AS builder

WORKDIR /build

COPY package.json package-lock.json tsconfig.json ./
RUN npm ci

COPY src ./src
RUN npm run build

FROM node:22-slim AS deps

WORKDIR /build

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM node:22-slim AS runtime

# Falsifier mutation: installs the Docker CLI into the shipped stage.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates docker.io \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./package.json
COPY --from=deps /build/node_modules ./node_modules
COPY --from=builder /build/dist ./dist

RUN rm -rf \
      /usr/local/lib/node_modules/npm \
      /usr/local/lib/node_modules/corepack \
      /usr/local/bin/npm \
      /usr/local/bin/npx \
      /usr/local/bin/corepack \
      /usr/local/bin/yarn \
      /usr/local/bin/yarnpkg \
      /usr/local/bin/pnpm \
      /usr/local/bin/pnpx \
      /opt/yarn-*

RUN groupadd --system executor \
    && useradd --system --gid executor --home-dir /app --no-create-home executor \
    && chown -R executor:executor /app

USER executor

ENV NODE_ENV=production

CMD ["node", "dist/src/main/index.js"]
