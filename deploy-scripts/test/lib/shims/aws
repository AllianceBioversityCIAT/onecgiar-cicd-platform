#!/usr/bin/env bash
# Fake `aws` CLI for LOCAL control-flow tests only.
#
# Also actively ASSERTS the security property requested for T-14: the script
# must exclude the leftover `~/.aws/credentials` file from the AWS CLI's
# credential provider chain (design proposal §10.10 / DD-11) -- NOT that it
# picks any particular provider in that chain. If deploy-container.sh ever
# invokes `aws` without AWS_SHARED_CREDENTIALS_FILE=/dev/null, this shim
# fails loudly.
set -uo pipefail

: "${AWS_FAKE_LOG:=/dev/null}"
printf 'aws %s\n' "$*" >> "$AWS_FAKE_LOG" 2>/dev/null || true

if [[ "${AWS_SHARED_CREDENTIALS_FILE:-}" != "/dev/null" ]]; then
  echo "FAKE_AWS: expected AWS_SHARED_CREDENTIALS_FILE=/dev/null (exclude ~/.aws/credentials), got '${AWS_SHARED_CREDENTIALS_FILE:-<unset>}'" >&2
  exit 9
fi

service="${1:-}"
op="${2:-}"

case "$service $op" in
  "secretsmanager get-secret-value")
    printf '%s' "${FAKE_SECRET_VALUE:-dummy-secret-value}"
    ;;
  "ecr get-login-password")
    printf 'fake-ecr-password-token'
    ;;
  *)
    exit 0
    ;;
esac
