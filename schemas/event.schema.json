{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecgiar-cicd-platform/schemas/event.schema.json",
  "title": "Internal event envelope",
  "$comment": "@akili-spec changes/cicd-executor-poc design 6.4; requirements FR-04. Reduced to the internal event types of design 6.4 (DEPLOY_REQUESTED has its own schema: deploy-request.schema.json). Envelope: specVersion, eventId (UUID), eventType, timestamp, source in {executor, scheduler, operator}. N-05: each eventType accepts ONLY its own fields. Exactly one oneOf branch matches (its eventType const), and unevaluatedProperties false rejects any property not evaluated by the envelope or by the matching branch. The sender class per type (DD-25: LOCK_RETRY_REQUESTED from executor, RECONCILE_TICK from scheduler, operator events from operator) is pinned through the branch's `source` const. Authenticating the real sender is FR-21 and is not a schema concern. Coverage of the target's externalDeployers by externalJobsDisabled and the bounds of closesAt are semantic checks outside the schema.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["specVersion", "eventId", "eventType", "timestamp", "source"],
  "properties": {
    "specVersion": { "const": 1 },
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": {
      "enum": [
        "LOCK_RETRY_REQUESTED",
        "RECONCILE_TICK",
        "DEPLOY_WINDOW_OPEN_REQUESTED",
        "DEPLOY_WINDOW_CLOSE_REQUESTED",
        "TARGET_RESOLUTION_RECORDED"
      ]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "source": { "enum": ["executor", "scheduler", "operator"] }
  },
  "oneOf": [
    {
      "properties": {
        "eventType": { "const": "LOCK_RETRY_REQUESTED" },
        "source": { "const": "executor" },
        "executionId": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 }
      },
      "required": ["executionId", "attempt"]
    },
    {
      "properties": {
        "eventType": { "const": "RECONCILE_TICK" },
        "source": { "const": "scheduler" }
      }
    },
    {
      "properties": {
        "eventType": { "const": "DEPLOY_WINDOW_OPEN_REQUESTED" },
        "source": { "const": "operator" },
        "lockKey": { "type": "string", "minLength": 1 },
        "openedBy": { "type": "string", "minLength": 1 },
        "externalJobsDisabled": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "closesAt": { "type": "string", "format": "date-time" },
        "note": { "type": "string", "maxLength": 1024 }
      },
      "required": ["lockKey", "openedBy", "externalJobsDisabled", "closesAt"]
    },
    {
      "properties": {
        "eventType": { "const": "DEPLOY_WINDOW_CLOSE_REQUESTED" },
        "source": { "const": "operator" },
        "lockKey": { "type": "string", "minLength": 1 },
        "closedBy": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "maxLength": 1024 }
      },
      "required": ["lockKey", "closedBy"]
    },
    {
      "properties": {
        "eventType": { "const": "TARGET_RESOLUTION_RECORDED" },
        "source": { "const": "operator" },
        "lockKey": { "type": "string", "minLength": 1 },
        "executionId": { "type": "string", "minLength": 1 },
        "resolvedBy": { "type": "string", "minLength": 1 },
        "observedDigests": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "note": { "type": "string", "maxLength": 1024 }
      },
      "required": ["lockKey", "executionId", "resolvedBy", "observedDigests"]
    }
  ]
}
