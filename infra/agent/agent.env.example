# Agent environment, shared-iam-user identity (architecture-change-04; docs/gate-b/13-agent-shared-identity.md).
# Copy to <AGENT_HOME>/config/agent.env, owned by the agent user, mode 0600. bin/start-agent.sh loads it with
# `node --env-file`; the agent itself never reads Secrets Manager.
# The two AWS values come from the Secrets Manager secret cicd/agents/credentials (keys of the same name), copied by
# the owner. Never commit the filled file, never print it, never paste it into a ticket or chat.
AWS_ACCESS_KEY_ID=<from cicd/agents/credentials>
AWS_SECRET_ACCESS_KEY=<from cicd/agents/credentials>
AWS_REGION=<AWS_REGION>
AWS_EC2_METADATA_DISABLED=true
CICD_AGENT_HOME=<AGENT_HOME>
NODE_ENV=production
