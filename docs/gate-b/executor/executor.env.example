# Executor environment for the Gate B local run (KEYS ONLY, placeholder values).
# Copy to executor/.local/executor.env (ignored by git through `.local/`) and fill in
# the real values there. NEVER commit real values and NEVER put static AWS keys here:
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN are refused by
# tools/gate-b/run-executor.{ps1,sh}. Credentials come from AWS_PROFILE below.
#
# Setup guide: docs/gate-b/05-run-executor-node22.md
# Format: KEY=VALUE, one per line. No shell evaluation, no variable expansion.

# --- AWS credentials (ISOLATED shared files, no static keys here) ---------------
# SR-3: the Executor runs as a dedicated least-privilege principal
# (<EXECUTOR_WORKSTATION_USER>) whose only permission is sts:AssumeRole on the
# ExecutorRole. Its key lives ONLY in the isolated files below, never in the default
# ~/.aws files. tools/gate-b/run-executor.{ps1,sh} REFUSE to run unless both files are
# set, ABSOLUTE, existing regular files under <executor-dir>/.local/aws/ (no symbolic
# link, junction or hard link), and not the default ~/.aws files. The config must define
# [profile <AWS_PROFILE>] with role_arn + source_profile and no credential_process,
# credential_source, sso_* or web_identity_token_file; the credentials file must not
# contain a section named like AWS_PROFILE. See docs/gate-b/05-run-executor-node22.md,
# "Dedicated Executor principal (SR-3)".
AWS_CONFIG_FILE=<REPO_ROOT>/executor/.local/aws/config
AWS_SHARED_CREDENTIALS_FILE=<REPO_ROOT>/executor/.local/aws/credentials
# The profile inside AWS_CONFIG_FILE with `role_arn` (the ExecutorRoleArn stack output)
# and `source_profile` (the dedicated user's key profile). The AWS SDK v3 reads the
# shared config on its own, so AWS_SDK_LOAD_CONFIG is not needed.
AWS_PROFILE=cicd-executor
# REQUIRED launcher guard (not passed to the Executor): the ExecutorRoleArn stack output.
# The launcher refuses to run unless role_arn of [profile <AWS_PROFILE>] in the isolated
# config equals this value exactly, so a profile cannot point at a more powerful role.
# Must look like arn:aws:iam::<AWS_ACCOUNT_ID>:role/<EXECUTOR_ROLE_NAME>.
CICD_EXECUTOR_ROLE_ARN=<EXECUTOR_ROLE_ARN>

# Region of the Gate B stack.
AWS_REGION=<AWS_REGION>

# --- SAM stack outputs (infra/sam/template.yaml) -------------------------------
# Output DeployQueueUrl.
CICD_QUEUE_URL=<DEPLOY_QUEUE_URL>
# Output ExecutionsTableName.
CICD_TABLE_NAME=<EXECUTIONS_TABLE_NAME>
# Output RegistryTableName (Target Registry, AC-02 V1; read with GetItem only).
CICD_REGISTRY_TABLE_NAME=<REGISTRY_TABLE_NAME>

# --- Logical principal references (resolved through Secrets Manager) -----------
# Must be logical <PLACEHOLDER> names (DD-23), never role IDs. Each resolves to an
# owner-created secret whose value is the matching *RoleId stack output (DD-25).
# The CI role shared by the authorized repositories (AC-02 V1; DEPLOY_REQUESTED sender).
CICD_CI_PRINCIPAL_REF=<CI_PRINCIPAL>
CICD_EXECUTOR_PRINCIPAL_REF=<EXECUTOR_PRINCIPAL>
CICD_SCHEDULER_PRINCIPAL_REF=<SCHEDULER_PRINCIPAL>
CICD_OPERATOR_PRINCIPAL_REF=<OPERATOR_PRINCIPAL>

# Platform Slack channel and token (logical refs) used for REJECTED notifications.
CICD_PLATFORM_SLACK_CHANNEL_REF=<PLATFORM_SLACK_CHANNEL>
CICD_PLATFORM_SLACK_TOKEN_REF=<PLATFORM_SLACK_TOKEN>

# Prefix prepended to each logical name to form the Secrets Manager secret id.
# Must match the SecretIdPrefix stack parameter. Optional (empty by default).
CICD_SECRET_ID_PREFIX=<SECRET_ID_PREFIX>

# --- Notification links --------------------------------------------------------
# Must contain the {executionId} placeholder.
CICD_LOGS_URL_TEMPLATE=https://<LOGS_HOST>/<LOGS_PATH>/{executionId}
CICD_RUNBOOK_URL=https://<RUNBOOK_HOST>/<RUNBOOK_PATH>

# --- Local run settings --------------------------------------------------------
# Directory that contains schemas/ (optional; the bundled schemas are used when
# unset). AC-02 V1 (R-6): only schemas/ is read from it; no deployment
# definition is loaded. The variable keeps its name until R-9.
CICD_DEFINITIONS_ROOT=<LOCAL_DEFINITIONS_ROOT>

# Optional. Healthcheck file path (default /tmp/cicd-executor.health).
# CICD_HEALTHCHECK_PATH=<HEALTHCHECK_PATH>

# Optional. Maximum concurrent SSH sessions (positive integer).
# CICD_SSH_CONCURRENCY=2

# Keep this key UNSET (commented) against AWS. Setting it points the Executor at a
# local emulator; the run scripts refuse it unless -AllowLocalEndpoint / --allow-local-endpoint.
# CICD_DYNAMODB_ENDPOINT=http://<LOCAL_EMULATOR_HOST>:<PORT>
